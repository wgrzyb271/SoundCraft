RSYNC_HOST=user@agent-server
RSYNC_REMOTE_PATH=/opt/agent/input

SFTP_HOST=agent-server
SFTP_USERNAME=user
SFTP_REMOTE_PATH=/opt/agent/input
SFTP_PRIVATE_KEY=/home/user/.ssh/id_rsa
SFTP_PORT=22

# Alternatywnie wszystkie wartości mogą pochodzić ze wspólnego YAML:
# SOUNDCRAFT_CONFIG=/absolute/path/to/SoundCraft/llm_agent/config.local.yaml
